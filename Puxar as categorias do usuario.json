    {
      "parameters": {
        "jsCode": "// Pega todas as categorias filtradas do usuário\nconst categoriasFiltradas = $input.all().map(item => item.json);\n\n// Cria uma lista no formato \"Nome (categoryId)\" para cada categoria\nconst listaCategorias = categoriasFiltradas\n    .map(cat => `${cat.name} (Tipo:${cat.type}) (${cat.categoryId})`)\n    .join(\", \");\n\n// Retorna no formato que pode ser injetado no prompt\nreturn [{ json: { categoriasPrompt: listaCategorias } }];\n\n"
